<Window x:Class="DocumentHelper.LookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentHelper"
        xmlns:lookup="clr-namespace:DocumentHelper.Lookup"
        Title="Turkish lookup"
        Width="460" MaxHeight="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#57606A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Flat icon button used for the "phrasal verbs & examples" toggle and the close button. -->
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="#57606A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAEEF2" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DDF4FF" />
                                <Setter Property="Foreground" Value="#0969DA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ExampleTemplate" DataType="{x:Type lookup:ExampleSentence}">
            <StackPanel Margin="0,2,0,6">
                <TextBlock Text="{Binding English}" Foreground="#1F2328" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Turkish}" Foreground="#57606A" FontStyle="Italic" TextWrapping="Wrap"
                           Visibility="{Binding Turkish, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow. -->
    <Border Margin="10" CornerRadius="8" Background="White" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.RenderTransform>
            <!-- Animated when the popup appears: it slides in a few pixels while fading in. -->
            <TranslateTransform x:Name="SlideTransform" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>

        <!-- Receives keyboard focus when the popup appears (see AppearAtAnchor). -->
        <DockPanel x:Name="RootPanel" Focusable="True" FocusVisualStyle="{x:Null}">
            <!-- Header: editable search box, so a word can also be typed or corrected. -->
            <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="16" FontWeight="SemiBold" Padding="4,2"
                         BorderThickness="0,0,0,1" BorderBrush="#D0D7DE" VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown" ToolTip="Type a word and press Enter" />
                <ToggleButton x:Name="ExtrasButton" Grid.Column="1" Style="{StaticResource IconButton}"
                              Visibility="Collapsed" Checked="OnExtrasToggled" Unchecked="OnExtrasToggled"
                              ToolTip="Phrasal verbs and example sentences">
                    <TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                </ToggleButton>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="Close (Esc)">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Margin="12,4,12,8"
                       Foreground="#8C959F" FontSize="11" />

            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Margin="14,2,14,4" TextWrapping="Wrap"
                       Foreground="#9A6700" Visibility="Collapsed" />

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12,0,12,4">
                <Grid>
                    <!-- Translations (default view). -->
                    <ItemsControl x:Name="SourcesList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SourceViewModel}">
                                <StackPanel Margin="0,6,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnOpenLink"
                                                       Foreground="#0969DA" TextDecorations="None">
                                                Open in browser ↗
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" />
                                    </DockPanel>
                                    <Separator Margin="0,3,0,4" Background="#EAEEF2" />

                                    <TextBlock Text="Searching…" Foreground="#8C959F" FontStyle="Italic"
                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Message}" Foreground="#8C959F" TextWrapping="Wrap"
                                               Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

                                    <ItemsControl ItemsSource="{Binding Meanings}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3,0,5">
                                                    <TextBlock Text="{Binding Turkish}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="#1F2328" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Context}" FontSize="11" Foreground="#8C959F"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Context, Converter={StaticResource NullToCollapsed}}" />
                                                    <TextBlock Text="{Binding Definition}" FontSize="12" Foreground="#57606A"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Definition, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Phrasal verbs and example sentences (opened with the book icon). -->
                    <StackPanel x:Name="ExtrasPanel" Visibility="Collapsed">
                        <StackPanel x:Name="PhrasalSection" Margin="0,6,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Oxford · Cambridge · Tureng" FontSize="11"
                                           Foreground="#8C959F" VerticalAlignment="Center" />
                                <TextBlock Text="Phrasal verbs" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <Separator Margin="0,3,0,4" Background="#EAEEF2" />
                            <ItemsControl x:Name="PhrasalList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PhrasalVerbViewModel}">
                                        <StackPanel Margin="0,4,0,9">
                                            <!-- "look after  –  bakmak, göz kulak olmak"; the phrase opens the full entry. -->
                                            <TextBlock FontSize="14" TextWrapping="Wrap">
                                                <Hyperlink NavigateUri="{Binding MoreUrl, Mode=OneWay}" RequestNavigate="OnOpenLink"
                                                           Foreground="#0969DA" TextDecorations="None" FontWeight="SemiBold"
                                                           ToolTip="Open the full entry in the browser">
                                                    <Run Text="{Binding Phrase, Mode=OneWay}" />
                                                </Hyperlink>
                                                <Run Text="{Binding Separator, Mode=OneWay}" Foreground="#8C959F" />
                                                <Run Text="{Binding Turkish, Mode=OneWay}" Foreground="#1F2328" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Pattern}" FontSize="12" Foreground="#57606A" TextWrapping="Wrap"
                                                       Visibility="{Binding Pattern, Converter={StaticResource NullToCollapsed}}" />
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="#8C959F"
                                                       Visibility="{Binding SourceLabel, Converter={StaticResource NullToCollapsed}}" />
                                            <TextBlock Text="Loading…" Margin="12,2,0,0" FontSize="11"
                                                       Foreground="#8C959F" FontStyle="Italic"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding NothingFound}" Margin="12,2,0,0" FontSize="11" Foreground="#8C959F"
                                                       Visibility="{Binding NothingFound, Converter={StaticResource NullToCollapsed}}" />

                                            <!-- English definitions with English example sentences. -->
                                            <ItemsControl ItemsSource="{Binding Senses}" Margin="12,2,0,0" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type lookup:PhrasalSense}">
                                                        <StackPanel Margin="0,2,0,4">
                                                            <TextBlock Text="{Binding Definition}" FontSize="12" Foreground="#57606A"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Definition, Converter={StaticResource NullToCollapsed}}" />
                                                            <ItemsControl ItemsSource="{Binding Examples}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,1,0,0">
                                                                            <TextBlock DockPanel.Dock="Left" Text="•" Margin="2,0,6,0" Foreground="#8C959F" />
                                                                            <TextBlock Text="{Binding}" FontStyle="Italic" Foreground="#1F2328" TextWrapping="Wrap" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Fallback when no dictionary has examples: Tatoeba, with Turkish translation. -->
                                            <ItemsControl ItemsSource="{Binding TranslatedExamples}" Margin="12,2,0,0" Focusable="False"
                                                          ItemTemplate="{StaticResource ExampleTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="ExamplesSection" Margin="0,6,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Hyperlink x:Name="TatoebaLink" RequestNavigate="OnOpenLink"
                                               Foreground="#0969DA" TextDecorations="None">
                                        More on Tatoeba ↗
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="ExamplesHeader" Text="Example sentences" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <Separator Margin="0,3,0,4" Background="#EAEEF2" />
                            <ItemsControl x:Name="ExampleList" Focusable="False" ItemTemplate="{StaticResource ExampleTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
